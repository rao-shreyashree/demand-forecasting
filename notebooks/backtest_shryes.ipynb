
# ============================================================
# 1. IMPORTS
# ============================================================

import pandas as pd
import numpy as np
import os
import sys

sys.path.append('..')

from src.schema import DATE_COL, STORE_COL, ITEM_COL, SALES_COL
from src.data import load_data, clean_data
from src.baselines import forecast_by_group
from src.backtest import rolling_origin_windows, evaluate_forecast, run_backtest

from src.metrics import wape, rmse, mape, bias

print("All imports OK")


# ============================================================
# 2. LOAD DATA
# ============================================================

df_raw = pd.read_csv('../data/raw/train.csv')
df_raw[DATE_COL] = pd.to_datetime(df_raw[DATE_COL])

df = (
    df_raw
    .sort_values([STORE_COL, ITEM_COL, DATE_COL])
    .reset_index(drop=True)
)

print("Loaded:", df.shape)
print("Date range:", df[DATE_COL].min(), "→", df[DATE_COL].max())


# ============================================================
# 3. ROLLING-ORIGIN WINDOWS
# ============================================================

def rolling_origin_windows(df, horizon=28, n_windows=3):

    all_dates = sorted(df[DATE_COL].unique())
    total_days = len(all_dates)

    if total_days < horizon * n_windows + 1:
        raise ValueError("Insufficient history for requested windows.")

    windows = []

    for i in range(n_windows):

        val_end_idx = total_days - 1 - (i * horizon)
        val_start_idx = val_end_idx - horizon + 1

        val_start = all_dates[val_start_idx]
        val_end = all_dates[val_end_idx]

        train_df = df[df[DATE_COL] < val_start].copy()

        val_df = df[
            (df[DATE_COL] >= val_start) &
            (df[DATE_COL] <= val_end)
        ].copy()

        windows.append({
            'window': i + 1,
            'train': train_df,
            'val': val_df,
            'val_start': val_start,
            'val_end': val_end
        })

    windows.reverse()
    return windows


windows = rolling_origin_windows(df, horizon=28, n_windows=3)

for w in windows:
    print(
        f"Window {w['window']}: "
        f"{w['val_start'].date()} → {w['val_end'].date()} | "
        f"Train: {len(w['train'])} | Val: {len(w['val'])}"
    )


# ============================================================
# 4. LOAD CLASSICAL MODEL FORECASTS
# ============================================================

classical_bt = pd.read_csv(
    '../data/processed/forecasts_classical_backtest.csv'
)

classical_bt[DATE_COL] = pd.to_datetime(classical_bt[DATE_COL])

required_cols = {
    DATE_COL, STORE_COL, ITEM_COL, 'y_hat', 'model'
}

missing = required_cols - set(classical_bt.columns)

if missing:
    raise ValueError(f"Missing columns in classical forecast CSV: {missing}")

classical_bt = classical_bt[
    list(required_cols)
].copy()

print("\nClassical forecast shape:", classical_bt.shape)
print("Classical models:", classical_bt['model'].unique())


# ============================================================
# 5. IDENTIFY THE FIXED TOP-10 SERIES
# ============================================================

# PR #10 uses a fixed cohort selected before the earliest
# validation window. Recover the exact cohort from its output.

top10_keys = (
    classical_bt[[STORE_COL, ITEM_COL]]
    .drop_duplicates()
    .sort_values([STORE_COL, ITEM_COL])
    .reset_index(drop=True)
)

if len(top10_keys) != 10:
    raise ValueError(
        f"Expected exactly 10 fixed series, found {len(top10_keys)}."
    )

print("\nFixed evaluation cohort:")
print(top10_keys.to_string(index=False))


# ============================================================
# 6. EVALUATION FUNCTION
# ============================================================

def evaluate_forecast(forecast_df, val_df, window_num):

    merged = val_df[
        [DATE_COL, STORE_COL, ITEM_COL, SALES_COL]
    ].merge(
        forecast_df[
            [DATE_COL, STORE_COL, ITEM_COL, 'y_hat', 'model']
        ],
        on=[DATE_COL, STORE_COL, ITEM_COL],
        how='inner',
        validate='one_to_many'
    )

    if merged.empty:
        raise ValueError(f"No matching forecasts in window {window_num}.")

    results = []

    for model_name, group in merged.groupby('model'):

        results.append({
            'window': window_num,
            'model': model_name,
            'wape': wape(group[SALES_COL], group['y_hat']),
            'rmse': rmse(group[SALES_COL], group['y_hat']),
            'mape': mape(group[SALES_COL], group['y_hat']),
            'bias': bias(group[SALES_COL], group['y_hat']),
            'n_rows': len(group)
        })

    return pd.DataFrame(results)


# ============================================================
# 7. GENERATE BASELINES FOR EACH WINDOW
# ============================================================

baseline_methods = [
    ("naive", {}),
    ("seasonal_naive", {"season": 7}),
    ("moving_average", {"window": 7}),
    ("moving_average", {"window": 28})
]


def combined_forecast(train_df, val_df):

    val_start = val_df[DATE_COL].min()
    val_end = val_df[DATE_COL].max()

    horizon = val_df[DATE_COL].nunique()

    # --------------------------------------------------------
    # A. Classical forecasts for this validation window
    # --------------------------------------------------------

    classical_window = classical_bt[
        (classical_bt[DATE_COL] >= val_start) &
        (classical_bt[DATE_COL] <= val_end)
    ].copy()

    classical_window = classical_window.merge(
        top10_keys,
        on=[STORE_COL, ITEM_COL],
        how='inner',
        validate='many_to_one'
    )

    # --------------------------------------------------------
    # B. Generate baselines using THIS window's train data
    # --------------------------------------------------------

    # Restrict training data to the fixed evaluation cohort.
    train_top10 = train_df.merge(
        top10_keys,
        on=[STORE_COL, ITEM_COL],
        how='inner',
        validate='many_to_one'
    )

    baseline_forecasts = []

    for method, kwargs in baseline_methods:

        forecast = forecast_by_group(
            train_top10,
            method=method,
            horizon=horizon,
            **kwargs
        )

        forecast[DATE_COL] = pd.to_datetime(forecast[DATE_COL])

        # Align generated forecast dates with validation dates.
        expected_dates = sorted(val_df[DATE_COL].unique())

        if not forecast[DATE_COL].isin(expected_dates).all():
            raise ValueError(
                f"{method} generated dates outside validation window "
                f"{val_start.date()} to {val_end.date()}."
            )

        baseline_forecasts.append(forecast)

    baselines_window = pd.concat(
        baseline_forecasts,
        ignore_index=True
    )

    # --------------------------------------------------------
    # C. Combine all models
    # --------------------------------------------------------

    combined = pd.concat(
        [classical_window, baselines_window],
        ignore_index=True
    )

    return combined


# ============================================================
# 8. RUN THE COMPLETE BACKTEST
# ============================================================

def run_backtest(forecast_fn, df, n_windows=3, horizon=28):

    windows = rolling_origin_windows(
        df,
        horizon=horizon,
        n_windows=n_windows
    )

    all_results = []

    for w in windows:

        print(
            f"\nEvaluating window {w['window']}: "
            f"{w['val_start'].date()} → {w['val_end'].date()}"
        )

        forecast_df = forecast_fn(w['train'], w['val'])

        result = evaluate_forecast(
            forecast_df,
            w['val'],
            w['window']
        )

        all_results.append(result)

    detailed = pd.concat(all_results, ignore_index=True)

    comparison = (
        detailed
        .groupby('model')[['wape', 'rmse', 'mape', 'bias']]
        .mean()
        .round(4)
        .sort_values('wape')
        .reset_index()
    )

    comparison['rank'] = range(1, len(comparison) + 1)

    return comparison, detailed


comparison_table, detailed = run_backtest(
    combined_forecast,
    df,
    n_windows=3,
    horizon=28
)


# ============================================================
# 9. VALIDATE EVALUATION COVERAGE
# ============================================================

print("\n=== Evaluation coverage ===")

print("Models:", sorted(detailed['model'].unique()))
print("Windows:", sorted(detailed['window'].unique()))

print("\nRows per model per window:")
print(
    detailed.pivot(
        index='model',
        columns='window',
        values='n_rows'
    ).to_string()
)

expected_rows = 10 * 28

if not (detailed['n_rows'] == expected_rows).all():
    raise ValueError(
        f"Expected {expected_rows} evaluation rows per model per window."
    )

if detailed['window'].nunique() != 3:
    raise ValueError("Expected exactly 3 evaluation windows.")

if detailed['model'].nunique() != 6:
    raise ValueError("Expected exactly 6 models.")


# ============================================================
# 10. FINAL MODEL COMPARISON
# ============================================================

print("\n=== Model Comparison ===")
print(comparison_table.to_string(index=False))


# ============================================================
# 11. SAVE RESULTS
# ============================================================

os.makedirs('../data/processed', exist_ok=True)

comparison_table.to_csv(
    '../data/processed/model_comparison_shryes.csv',
    index=False
)

detailed.to_csv(
    '../data/processed/backtest_detailed_shryes.csv',
    index=False
)

print("\nSaved:")
print("  data/processed/model_comparison_shryes.csv")
print("  data/processed/backtest_detailed_shryes.csv")
